---
import '../styles/tailwind.css'
import '../styles/global.css'
import sitePackage from '../../package.json'

interface Props {
  title?: string
  description?: string
  image?: string
  pageClass?: string
  active?: 'home' | 'docs'
  chrome?: boolean
}

const {
  title = 'Open MindMap - Interactive mind maps for React',
  description = 'A modular React and TypeScript runtime for deterministic SVG mind maps, interactive viewing, editing, and Markdown streaming.',
  image = '/screenshot.png',
  pageClass = '',
  active,
  chrome = true,
} = Astro.props

const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).toString()
const ogImage = new URL(image, Astro.site ?? Astro.url.origin).toString()
const getStartedHref = active === 'docs' ? '/docs/#getting-started' : '/live/'
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Open MindMap',
  description,
  url: 'https://mindmap.u14.app',
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'Any',
  softwareVersion: sitePackage.version,
  license: 'https://www.apache.org/licenses/LICENSE-2.0',
  codeRepository: 'https://github.com/u14app/mindmap',
  programmingLanguage: ['TypeScript', 'React'],
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
}
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="Content-Security-Policy" content="connect-src 'self' https://open-mindmap-ai.u14.app; img-src 'self' data:; object-src 'none'; base-uri 'self'" />
    <meta name="referrer" content="no-referrer" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#ffffff" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0f1117" />
    <meta name="description" content={description} />
    <meta name="keywords" content="mindmap, mind map, React, TypeScript, SVG, Markdown, AI streaming, Astro" />
    <meta name="author" content="U14App" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/logo.png" type="image/png" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Open MindMap" />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <title>{title}</title>
  </head>
  <body class:list={['bg-white text-on-surface dark:bg-[#0f1117] dark:text-slate-300', pageClass]}>
    <a class="skip-link" href="#main-content">Skip to content</a>
    {chrome && (
      <nav class="legacy-site-nav fixed top-0 z-50 w-full border-b border-surface-container-high/50 bg-white/80 transition-all duration-300 dark:border-slate-700/50 dark:bg-slate-900/80" data-site-nav>
        <div class="mx-auto flex max-w-7xl items-center justify-between px-4 py-3 md:px-6">
          <div class="flex min-w-0 items-center">
            <a href="/" class="flex items-center gap-2 text-lg font-bold tracking-tight text-slate-900 no-underline dark:text-white" aria-label="Open MindMap home">
              <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-lg text-white"><img src="/logo.png" class="scale-150" width="28" height="28" alt="" /></span>
              <span class="hidden sm:block">Open MindMap</span>
            </a>
            <div class="ml-5 flex items-center gap-4 text-[13px] font-medium sm:ml-10 sm:gap-8">
              <a class:list={[active === 'home' ? 'text-slate-900 dark:text-white' : 'text-slate-500 transition-colors hover:text-slate-900 dark:text-slate-400 dark:hover:text-white']} aria-current={active === 'home' ? 'page' : undefined} href="/">Home</a>
              <a class:list={[active === 'docs' ? 'text-slate-900 dark:text-white' : 'text-slate-500 transition-colors hover:text-slate-900 dark:text-slate-400 dark:hover:text-white']} aria-current={active === 'docs' ? 'page' : undefined} href="/docs/">Docs</a>
              <a class="text-slate-500 transition-colors hover:text-slate-900 dark:text-slate-400 dark:hover:text-white" href="https://github.com/u14app/mindmap" target="_blank" rel="noopener noreferrer">GitHub</a>
            </div>
          </div>
          <a href={getStartedHref} class="ml-3 hidden shrink-0 rounded-full bg-primary px-4 py-1.5 text-[13px] font-semibold text-white transition-all hover:scale-105 hover:bg-primary/90 md:flex">Get Started</a>
        </div>
      </nav>
    )}

    <slot />

    {chrome && (
      <footer class="w-full border-t border-slate-100 bg-white px-4 py-8 dark:border-slate-800 dark:bg-slate-900 md:px-8">
        <div class="mx-auto max-w-7xl">
          <div class="mb-12 grid grid-cols-2 gap-8 md:mb-16 md:grid-cols-4 md:gap-12">
            <div class="col-span-2 md:col-span-1">
              <a href="/" class="mb-6 block text-lg font-bold tracking-tight text-slate-900 dark:text-white">Open MindMap</a>
              <p class="text-sm font-medium leading-relaxed text-slate-500 dark:text-slate-400">Open source &amp; community driven.<br />Built for the modern web.</p>
            </div>
            <div>
              <h5 class="mb-6 text-[11px] font-bold uppercase tracking-widest text-slate-400">Engineering</h5>
              <ul class="space-y-4 text-[13px] font-semibold text-slate-600 dark:text-slate-400">
                <li><a class="transition-colors hover:text-primary" href="/docs/">Documentation</a></li>
                <li><a class="transition-colors hover:text-primary" href="/docs/#api-reference">API Reference</a></li>
                <li><a class="transition-colors hover:text-primary" href="/docs/#getting-started">React SDK</a></li>
                <li><a class="transition-colors hover:text-primary" href="/docs/#extended-syntax">Extension Guide</a></li>
              </ul>
            </div>
            <div>
              <h5 class="mb-6 text-[11px] font-bold uppercase tracking-widest text-slate-400">Community</h5>
              <ul class="space-y-4 text-[13px] font-semibold text-slate-600 dark:text-slate-400">
                <li><a class="transition-colors hover:text-primary" href="https://github.com/u14app/mindmap" target="_blank" rel="noopener noreferrer">GitHub</a></li>
                <li><a class="transition-colors hover:text-primary" href="https://www.npmjs.com/package/@xiangfa/mindmap" target="_blank" rel="noopener noreferrer">npm</a></li>
                <li><a class="transition-colors hover:text-primary" href="https://github.com/u14app/mindmap/blob/HEAD/CHANGELOG.md" target="_blank" rel="noopener noreferrer">Changelog</a></li>
                <li><a class="transition-colors hover:text-primary" href="/live/">Live demo</a></li>
              </ul>
            </div>
            <div>
              <h5 class="mb-6 text-[11px] font-bold uppercase tracking-widest text-slate-400">Legal</h5>
              <ul class="space-y-4 text-[13px] font-semibold text-slate-600 dark:text-slate-400">
                <li><a class="transition-colors hover:text-primary" href="https://github.com/u14app/mindmap/blob/HEAD/LICENSE" target="_blank" rel="noopener noreferrer">Apache-2.0 License</a></li>
                <li><a class="transition-colors hover:text-primary" href="https://github.com/u14app/mindmap" target="_blank" rel="noopener noreferrer">Source code</a></li>
                <li><a class="transition-colors hover:text-primary" href="/docs/#input-boundaries">Security boundaries</a></li>
              </ul>
            </div>
          </div>
          <div class="flex flex-col items-center justify-between border-t border-slate-100 pt-6 dark:border-slate-800 md:flex-row">
            <p class="text-[11px] font-bold uppercase tracking-[0.2em] text-slate-400">&copy; 2026 Open MindMap. Open Source.</p>
          </div>
        </div>
      </footer>
    )}

    <script is:inline>
      const nav = document.querySelector('[data-site-nav]');
      const updateNav = () => nav?.classList.toggle('is-scrolled', window.scrollY > 10);
      updateNav();
      window.addEventListener('scroll', updateNav, { passive: true });

      const legacyDocsAnchors = new Map([
        ['syntax', 'basic-syntax'],
        ['ai', 'ai-generation'],
        ['styling', 'custom-styling'],
        ['api', 'api-reference'],
      ]);
      const redirectLegacyHash = () => {
        const legacyHash = window.location.hash;
        if (window.location.pathname !== '/' || !legacyHash.startsWith('#/')) return;

        if (legacyHash.startsWith('#/live')) {
          window.location.replace('/live/');
          return;
        }

        if (legacyHash.startsWith('#/docs')) {
          const legacyAnchor = legacyHash.slice('#/docs'.length).replace(/^[#\/]+/, '');
          const anchor = legacyDocsAnchors.get(legacyAnchor) ?? legacyAnchor;
          window.location.replace(`/docs/${anchor ? `#${anchor}` : ''}`);
        }
      };
      redirectLegacyHash();
      window.addEventListener('hashchange', redirectLegacyHash);

      const animated = document.querySelectorAll('[data-animate]');
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window)) {
        animated.forEach(element => element.classList.add('animate-fade-in-up'));
      } else {
        const observer = new IntersectionObserver(entries => {
          entries.forEach(entry => {
            if (!entry.isIntersecting) return;
            entry.target.classList.add('animate-fade-in-up');
            observer.unobserve(entry.target);
          });
        }, { threshold: 0.1, rootMargin: '0px 0px -50px 0px' });
        animated.forEach(element => observer.observe(element));
      }
    </script>
  </body>
</html>

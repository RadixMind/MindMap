---
import '../styles/global.css'

interface Props {
  title?: string
  description?: string
  image?: string
  pageClass?: string
}

const {
  title = 'Open MindMap - Modular React Mind Map Runtime',
  description = 'Streaming Markdown visualized as thought. A modular React mind map runtime with static, viewer, editor, and opt-in features.',
  image = '/og.svg',
  pageClass = '',
} = Astro.props
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).toString()
const ogImage = new URL(image, Astro.site ?? Astro.url.origin).toString()
---
<!doctype html>
<html lang="en" data-theme="auto">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="Content-Security-Policy" content="img-src 'self' data:; object-src 'none'; base-uri 'self'" />
    <meta name="referrer" content="no-referrer" />
    <meta name="theme-color" content="#f4f7fb" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Open MindMap" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <title>{title}</title>
  </head>
  <body class={pageClass}>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div class="scroll-sentinel" data-scroll-sentinel aria-hidden="true"></div>
    <header class="site-header" data-site-header>
      <div class="site-header__inner shell shell--wide">
        <a class="brand" href="/" aria-label="Open MindMap home">
          <svg class="brand__mark" viewBox="0 0 44 44" aria-hidden="true">
            <rect x="1" y="1" width="42" height="42" rx="13" fill="currentColor" opacity=".08" />
            <circle cx="12" cy="22" r="3" fill="currentColor" />
            <circle cx="32" cy="12" r="3" fill="currentColor" />
            <circle cx="32" cy="32" r="3" fill="currentColor" />
            <path d="M15 22c8 0 8-10 14-10M15 22c8 0 8 10 14 10" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" />
          </svg>
          <span class="brand__name">Open MindMap</span>
          <span class="brand__version">v0.9.0</span>
        </a>
        <nav class="site-nav" aria-label="Primary navigation">
          <a href="/docs/">Docs</a>
          <a href="/#runtime">Runtime</a>
          <a href="/#benchmarks">Benchmarks</a>
          <a href="/playground/">Playground</a>
        </nav>
        <div class="site-actions">
          <a class="icon-link" href="https://github.com/u14app/mindmap" target="_blank" rel="noreferrer" aria-label="GitHub repository">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 .7a11.5 11.5 0 0 0-3.64 22.41c.58.11.79-.25.79-.56v-2.23c-3.22.7-3.9-1.36-3.9-1.36-.52-1.34-1.28-1.69-1.28-1.69-1.05-.72.08-.71.08-.71 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.57-.29-5.27-1.28-5.27-5.69 0-1.26.45-2.29 1.19-3.09-.12-.29-.52-1.47.11-3.05 0 0 .97-.31 3.16 1.18A10.97 10.97 0 0 1 12 6.12c.98 0 1.95.13 2.86.38 2.2-1.49 3.16-1.18 3.16-1.18.63 1.58.23 2.76.11 3.05.74.8 1.19 1.83 1.19 3.09 0 4.42-2.71 5.39-5.29 5.68.42.36.79 1.07.79 2.16v3.25c0 .31.21.68.8.56A11.5 11.5 0 0 0 12 .7Z" /></svg>
          </a>
          <button class="theme-toggle" type="button" data-theme-toggle aria-label="Use dark theme" aria-pressed="false">
            <span aria-hidden="true">◐</span>
            <span data-theme-label>Theme</span>
          </button>
          <a class="button button--small button--light" href="/playground/">Open playground</a>
        </div>
        <details class="mobile-menu">
          <summary aria-label="Open navigation"><span></span><span></span></summary>
          <nav>
            <a href="/docs/">Docs</a>
            <a href="/#runtime">Runtime</a>
            <a href="/#benchmarks">Benchmarks</a>
            <a href="/playground/">Playground</a>
            <a href="https://github.com/u14app/mindmap">GitHub</a>
            <button class="theme-toggle theme-toggle--mobile" type="button" data-theme-toggle aria-label="Use dark theme" aria-pressed="false">
              <span aria-hidden="true">◐</span>
              <span data-theme-label>Theme</span>
            </button>
          </nav>
        </details>
      </div>
    </header>
    <main id="main-content">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="shell site-footer__inner">
        <div>
          <a class="brand brand--footer" href="/">
            <svg class="brand__mark" viewBox="0 0 44 44" aria-hidden="true">
              <circle cx="12" cy="22" r="3" fill="currentColor" />
              <circle cx="32" cy="12" r="3" fill="currentColor" />
              <circle cx="32" cy="32" r="3" fill="currentColor" />
              <path d="M15 22c8 0 8-10 14-10M15 22c8 0 8 10 14 10" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" />
            </svg>
            <span class="brand__name">Open MindMap</span>
          </a>
          <p>Streaming Markdown, visualized as thought.</p>
        </div>
        <div class="site-footer__links">
          <div><strong>Product</strong><a href="/playground/">Playground</a><a href="/docs/">Documentation</a></div>
          <div><strong>Runtime</strong><a href="/docs/#runtime">Public entrypoints</a><a href="/docs/#architecture">Architecture</a><a href="/docs/#features">Features</a></div>
          <div><strong>Project</strong><a href="https://github.com/u14app/mindmap">GitHub</a><a href="https://www.npmjs.com/package/@xiangfa/mindmap">npm</a></div>
        </div>
      </div>
      <div class="shell site-footer__meta"><span>Apache-2.0</span><span>Designed for AI-native interfaces.</span></div>
    </footer>
    <script is:inline>
      const header = document.querySelector('[data-site-header]');
      const sentinel = document.querySelector('[data-scroll-sentinel]');
      if (header && sentinel && 'IntersectionObserver' in window) {
        const observer = new IntersectionObserver(([entry]) => {
          header.classList.toggle('is-scrolled', !entry.isIntersecting);
        });
        observer.observe(sentinel);
      }

      const themeKey = 'open-mindmap-theme';
      const themeChangeEvent = 'open-mindmap:theme-change';
      const root = document.documentElement;
      const themeButtons = document.querySelectorAll('[data-theme-toggle]');
      const themeLabels = document.querySelectorAll('[data-theme-label]');
      const systemTheme = window.matchMedia('(prefers-color-scheme: dark)');
      let storedTheme = null;
      try { storedTheme = localStorage.getItem(themeKey); } catch {}
      if (storedTheme === 'light' || storedTheme === 'dark') {
        root.dataset.theme = storedTheme;
        window.dispatchEvent(new CustomEvent(themeChangeEvent, { detail: storedTheme }));
      }

      const syncThemeControls = () => {
        const dark = root.dataset.theme === 'dark' || (root.dataset.theme === 'auto' && systemTheme.matches);
        themeButtons.forEach((button) => {
          button.setAttribute('aria-pressed', String(dark));
          button.setAttribute('aria-label', dark ? 'Use light theme' : 'Use dark theme');
        });
        themeLabels.forEach((label) => { label.textContent = dark ? 'Light' : 'Dark'; });
      };
      syncThemeControls();
      systemTheme.addEventListener?.('change', syncThemeControls);
      themeButtons.forEach((button) => {
        button.addEventListener('click', () => {
          const currentDark = root.dataset.theme === 'dark' || (root.dataset.theme === 'auto' && systemTheme.matches);
          const nextTheme = currentDark ? 'light' : 'dark';
          root.dataset.theme = nextTheme;
          try { localStorage.setItem(themeKey, nextTheme); } catch {}
          window.dispatchEvent(new CustomEvent(themeChangeEvent, { detail: nextTheme }));
          syncThemeControls();
        });
      });

      const legacyHash = window.location.hash;
      if (window.location.pathname === '/' && legacyHash.startsWith('#/')) {
        const route = legacyHash.slice(2);
        const [path, ...hashParts] = route.split('#');
        let hash = hashParts.join('#');
        let target = '/';
        if (path === 'docs' || path.startsWith('docs/')) {
          const docsPath = path.slice('docs'.length).replace(/^\/+/, '');
          target = docsPath ? `/docs/${docsPath.replace(/\/+$/, '')}/` : '/docs/';
          if (path === 'docs') {
            const legacyDocsAliases = new Map([
              ['getting-started', { target: '/docs/getting-started/', hash: '' }],
              ['basic-syntax', { target: '/docs/syntax/', hash: 'basic-syntax' }],
              ['text-formatting', { target: '/docs/syntax/', hash: 'text-formatting' }],
              ['links-images', { target: '/docs/syntax/', hash: 'links-images' }],
              ['remarks', { target: '/docs/syntax/', hash: 'remarks' }],
              ['comments', { target: '/docs/syntax/', hash: 'comments' }],
              ['task-status', { target: '/docs/syntax/', hash: 'task-status' }],
              ['extended-syntax', { target: '/docs/syntax/', hash: 'extended-syntax' }],
              ['ai-generation', { target: '/docs/ai/', hash: 'ai-generation' }],
              ['custom-styling', { target: '/docs/styling/', hash: 'custom-styling' }],
              ['api-reference', { target: '/docs/api/', hash: 'api-reference' }],
              ['keyboard-shortcuts', { target: '/docs/api/', hash: 'keyboard-shortcuts' }],
              ['utility-functions', { target: '/docs/api/', hash: 'utility-functions' }],
            ]);
            const alias = legacyDocsAliases.get(hash);
            if (alias) {
              target = alias.target;
              hash = alias.hash;
            }
          }
        }
        if (path === 'live' || path.startsWith('live/')) target = '/playground/';
        window.location.replace(`${target}${hash ? `#${hash}` : ''}`);
      }
    </script>
  </body>
</html>

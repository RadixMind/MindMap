---
import { ChevronUp, Menu, X } from 'lucide-react'
import DocsContent from '../../components/DocsContent'
import DocsSidebar from '../../components/DocsSidebar.astro'
import SiteLayout from '../../layouts/SiteLayout.astro'
---
<SiteLayout
  active="docs"
  pageClass="docs-page"
  title="Documentation - Open MindMap v0.9.0"
  description="Complete Open MindMap v0.9.0 documentation for Markdown syntax, React surfaces, Features, Extensions, AI streaming, styling, and public APIs."
>
  <main id="main-content" class="min-h-screen bg-white dark:bg-slate-900" data-docs-page>
    <div class="mx-auto flex max-w-7xl px-4 pt-[68px] md:px-6">
      <aside class="docs-sidebar-scroll sticky top-[68px] hidden h-[calc(100vh-68px)] shrink-0 overflow-y-auto py-8 pr-8 lg:block">
        <DocsSidebar />
      </aside>

      <div class="min-w-0 flex-1 py-8 lg:pl-4">
        <button class="mb-7 inline-flex items-center gap-2 rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm font-semibold text-slate-700 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 lg:hidden" type="button" data-docs-menu aria-controls="docs-mobile-drawer" aria-expanded="false">
          <Menu size={18} aria-hidden="true" /> Browse sections
        </button>
        <article class="docs-content max-w-3xl">
          <DocsContent />
        </article>
      </div>
    </div>

    <div class="docs-overlay fixed inset-0 z-[60] lg:hidden" data-docs-overlay hidden>
      <aside id="docs-mobile-drawer" class="docs-sidebar-scroll absolute inset-y-0 left-0 w-72 overflow-y-auto bg-white p-6 pt-5 shadow-2xl dark:bg-slate-900" aria-label="Mobile documentation navigation">
        <div class="mb-6 flex items-center justify-between">
          <strong class="text-sm text-slate-900 dark:text-white">Documentation</strong>
          <button class="rounded-lg p-2 text-slate-500 hover:bg-slate-100 dark:hover:bg-slate-800" type="button" data-docs-close aria-label="Close documentation navigation"><X size={20} aria-hidden="true" /></button>
        </div>
        <DocsSidebar />
      </aside>
    </div>

    <button class="docs-back-to-top fixed bottom-6 right-6 z-40 flex h-10 w-10 items-center justify-center rounded-full bg-slate-900 text-white shadow-lg hover:bg-primary dark:bg-slate-700" type="button" data-docs-top aria-label="Back to top" hidden><ChevronUp size={20} aria-hidden="true" /></button>
  </main>
  <script>
    import '../../scripts/docs'
  </script>
</SiteLayout>

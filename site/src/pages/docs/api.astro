          <tr><td><code>onMarkdownChange</code></td><td><code>(markdown: string) =&gt; void</code></td><td>—</td><td>Receives serialized Markdown changes</td></tr>
          <tr><td><code>onEvent</code></td><td><code>(event: MindMapControllerEvent) =&gt; void</code></td><td>—</td><td>Receives controller events</td></tr>

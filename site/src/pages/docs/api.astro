          <tr><td><code>remoteImagePolicy</code></td><td><code>'deny' | 'allow' | ((url) =&gt; boolean)</code></td><td><code>deny</code></td><td>Authorize sanitized remote image origins; overrides a controller policy</td></tr>
          <tr><td><code>document</code></td><td><code>MindMapDocument</code></td><td>—</td><td>Controlled Document source</td></tr>
          <tr><td><code>documentRevision</code></td><td><code>string | number</code></td><td>—</td><td>Force-reset token; changing it replaces the Document, clears history, and cancels active work</td></tr>
          <tr><td><code>data</code></td><td><code>MindMapNode | MindMapNode[]</code></td><td>—</td><td>Node or root-node input</td></tr>
          <tr><td><code>markdown</code></td><td><code>string</code></td><td>—</td><td>Controlled Markdown source</td></tr>
          <tr><td><code>defaultMarkdown</code></td><td><code>string</code></td><td>—</td><td>Initial Markdown source</td></tr>
          <tr><td><code>direction</code></td><td><code>MindMapDirection</code></td><td>Document/default</td><td>Layout direction input</td></tr>
          <tr><td><code>defaultDirection</code></td><td><code>MindMapDirection</code></td><td><code>both</code></td><td>Initial layout direction</td></tr>
          <tr><td><code>locale</code></td><td><code>string</code></td><td>browser</td><td>Message locale</td></tr>
          <tr><td><code>messages</code></td><td><code>Partial&lt;MindMapMessages&gt;</code></td><td>—</td><td>Override selected UI strings</td></tr>
          <tr><td><code>extensions</code></td><td><code>readonly MindMapExtension[]</code></td><td><code>[]</code></td><td>Parser, serializer, layout, and rendering extensions</td></tr>
          <tr><td><code>features</code></td><td><code>readonly MindMapEditorFeature[]</code></td><td><code>[]</code></td><td>Optional editor capabilities</td></tr>
          <tr><td><code>theme</code></td><td><code>MindMapThemeMode</code></td><td><code>auto</code></td><td>Light, dark, or system theme</td></tr>
